# HTML — никогда не кэшировать (ни браузером, ни CF edge)
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# SW — критично не кэшировать
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/manifest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# JS/CSS — версионированы через ?v=, не кэшируем
/*.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/*.css
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
